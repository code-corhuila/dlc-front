# Read by deploy/compose.yml (demo deployment). Placeholders only.
FRONT_PORT=8080

IAM_UPSTREAM=http://iam-portal-demo

PATIENT_UPSTREAM=http://patient-portal-demo
PATIENT_NETWORK=dlc-patient-portal_default

CLINICAL_UPSTREAM=http://clinical-portal-demo
CLINICAL_NETWORK=dlc-clinical-portal_default

APPOINTMENTS_UPSTREAM=http://appointments-portal-demo
APPOINTMENTS_NETWORK=dlc-front

BILLING_UPSTREAM=http://billing-portal-demo
BILLING_NETWORK=dlc-billing-portal_default

GATEWAY_UPSTREAM=http://mock-gateway:4010

# Local dlc-docs OpenAPI folder mounted read-only by the mock profile.
DLC_DOCS_OPENAPI=../../../../dlc-docs/dlc-docs/07-api/contracts/openapi

# Read by npm run preview.
PORT=4180
# Optional preview: an IAM asset server exposing the versioned /portals/iam/ path.
IAM_ORIGIN=http://127.0.0.1:4202
PATIENT_ORIGIN=http://127.0.0.1:4177
CLINICAL_ORIGIN=http://localhost:4175
BILLING_ORIGIN=http://localhost:4204
