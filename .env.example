# Read by deploy/compose.yml. Placeholders only.
FRONT_PORT=8080
# Use fixtures/portal-registry.clinical-live.json for the real Clinical portal.
# Supply an absolute path when running Compose from another directory.
# PORTAL_REGISTRY_FILE=../fixtures/portal-registry.json

IAM_UPSTREAM=http://iam-portal-demo

PATIENT_UPSTREAM=http://patient-portal-demo
PATIENT_NETWORK=dlc-patient-portal_default

CLINICAL_UPSTREAM=http://clinical-portal-demo
CLINICAL_NETWORK=dlc-clinical-portal_default

APPOINTMENTS_UPSTREAM=http://appointments-portal-dlc-front
APPOINTMENTS_NETWORK=dlc-front

BILLING_UPSTREAM=http://billing-portal-demo
BILLING_NETWORK=dlc-billing-portal_default

# Real Gateway on the platform network (it keeps /api/v1); it must trust this container as proxy.
GATEWAY_UPSTREAM=http://dlc-api-gateway:8080/api/v1
PLATFORM_NETWORK=platform
# Absolute path to this stage's {issuer, audience} file (see deploy/auth-config.example.json).
AUTH_CONFIG_FILE=/absolute/path/auth-config.json

# Read by npm run preview.
PORT=4180
# Optional preview: an IAM asset server exposing the versioned /portals/iam/ path.
IAM_ORIGIN=http://127.0.0.1:4202
PATIENT_ORIGIN=http://127.0.0.1:4177
CLINICAL_ORIGIN=http://localhost:4175
BILLING_ORIGIN=http://localhost:4204
